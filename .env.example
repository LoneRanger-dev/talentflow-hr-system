# =================================================================
# TalentFlow Autonomous HR System Environment Configuration
# =================================================================

# 1. Primary AI Model Configuration (Google Gemini API)
# Get your Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Alternative Premium Model (OpenAI - Optional)
OPENAI_API_KEY=

# 3. Local Free LLM (Ollama - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 4. Default Selected Provider: "gemini" | "openai" | "ollama" | "auto"
DEFAULT_LLM_PROVIDER=gemini

# 5. System API Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
